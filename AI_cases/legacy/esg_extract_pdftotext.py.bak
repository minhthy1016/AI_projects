#!/usr/bin/env python3
"""
Silver B — trích esg_claim từ Sustainability Statement (ESRS) trong báo cáo OMV.

Khác Silver A ở ba điểm cốt lõi, và đó là lý do hai bảng không gộp được:
  - giá trị có thể KHÔNG phải số (mục tiêu, mô tả phương pháp, phạm vi)
  - mỗi claim mang scope / boundary / baseline / assurance riêng
  - đơn vị là tCO2e, và nhầm t / kt / Mt là lỗi 1000× y hệt bên tài chính

Khung tham chiếu ở đây là ESRS chứ không phải GRI — OMV 2025 công bố theo CSRD.
Đây chính là lý do schema cần trường `framework` bọc ngoài `gri_code`.
"""
import argparse, hashlib, json, pathlib, re, sys
from decimal import Decimal

# nhãn dòng -> (scope, có phải tổng không)
EMISSION_ROWS = {
    "Scope-1- und Scope-2-Treibhausgasemissionen (marktbezogen)": ("combined_1_2_market", True),
    "Scope-1-THG-Bruttoemissionen":                               ("scope_1", True),
    "Standortbezogene Scope-2-THG-Bruttoemissionen":              ("scope_2_location", True),
    "Marktbezogene Scope-2-THG-Bruttoemissionen":                 ("scope_2_market", True),
    "Gesamte indirekte (Scope-3-)THG-Bruttoemissionen (alle wesentlichen Kategorien)":
                                                                  ("scope_3", True),
    "Gesamte indirekte (Scope-3-)THG-Bruttoemissionen (z.r.) [unternehmensspezifisch]":
                                                                  ("scope_3", True),
    "davon aus Energiesegmenten von OMV":                         ("scope_1", False),
    "davon aus Nichtenergiesegmenten von OMV":                    ("scope_1", False),
}
# chỉ tiêu do công ty tự định nghĩa, không phải chỉ tiêu ESRS bắt buộc
COMPANY_SPECIFIC = "[unternehmensspezifisch]"

ESRS_CODE = re.compile(r"\[((?:E1|E2|E3|E4|E5|S1|S2|S3|S4|G1|MDR)[^\]]*)\]")
NUM_DE = re.compile(r"\d[\d.]{3,}")

def de_num(t):
    """'13.920.157' -> Decimal(13920157). Dấu chấm là phân cách NGHÌN."""
    return Decimal(t.replace(".", ""))

def find_years(line):
    return [m.group(1) for m in re.finditer(r"(?<!\d)(20[0-4]\d)(?!\d)", line)]

def extract_emissions(pages, company_id, doc_hash, run_id):
    """Bảng E1-6: THG-Bruttoemissionen Scope 1/2/3."""
    out = []
    for pno, page in enumerate(pages, 1):
        # Trang 67 có HAI bảng cùng chứa "In t CO2e". Bảng đầu là phân tách
        # consolidated group (header chỉ có 2024/2025), bảng sau mới là E1-6
        # (header có 2019 Basisjahr). Lấy cái đầu tiên -> dùng nhầm header ->
        # giá trị năm gốc 2019 bị gán cho 2024, cả bảng lệch một cột, im lặng.
        # Neo vào TIÊU ĐỀ bảng, đừng neo vào dòng đơn vị.
        anchor = page.find("THG-Bruttoemissionen der Kategorien Scope 1, 2 und 3")
        if anchor < 0:
            continue
        i = page.find("In t CO2e", anchor)
        if i < 0:
            continue
        blk = page[i:]
        codes = ESRS_CODE.findall(page[max(0, i - 900):i])
        # dòng header mang các năm; "2019 (Basisjahr)" -> năm gốc
        # Lấy dòng header có NHIỀU năm nhất trong vùng đầu khối, ưu tiên dòng
        # có chữ "Basisjahr". Bản đầu lấy dòng ĐẦU TIÊN có >=2 năm và trúng một
        # dòng chỉ có [2024, 2025] -> giá trị năm gốc 2019 bị gán cho 2024, cả
        # bảng lệch một cột. Sai im lặng: mọi con số vẫn trông hợp lý, chỉ sai năm.
        # Đây đúng là lỗi period misassignment trong danh sách bottleneck.
        years, baseline_year, hdr = [], None, ""
        best = []
        for l in blk.split("\n")[:15]:
            ys = find_years(l)
            if len(ys) > len(best) or (len(ys) == len(best) and "Basisjahr" in l):
                best, hdr = ys, l
        if len(best) < 2:
            continue
        years = best
        if "Basisjahr" in hdr:
            m = re.search(r"(20\d{2})\s*\(Basisjahr\)", hdr)
            baseline_year = int(m.group(1)) if m else int(years[0])
        if not years:
            continue
        for ln, line in enumerate(blk.split("\n")):
            label = line[:130].strip()
            key = next((k for k in EMISSION_ROWS if label.startswith(k)), None)
            if not key:
                continue
            scope, is_total = EMISSION_ROWS[key]
            nums = NUM_DE.findall(line)
            # Ánh xạ theo THỨ TỰ token, hợp lệ vì bảng này mọi dòng đều đủ 3 cột.
            # Nếu số cột không khớp thì BỎ và gắn cờ, không đoán bừa — đoán ở đây
            # là gán số của năm này sang năm khác, đúng lỗi period misassignment.
            if len(nums) < len(years):
                out.append({"_skipped": label, "_reason": f"{len(nums)} số / {len(years)} cột"})
                continue
            for ci, (yr, tok) in enumerate(zip(years, nums)):
                out.append({
                    "claim_id": hashlib.sha256(f"{doc_hash}{pno}{ln}{ci}".encode()).hexdigest()[:32],
                    "run_id": run_id, "doc_hash": doc_hash, "company_id": company_id,
                    "report_year": int(years[-1]),
                    "framework": "ESRS", "framework_version": "ESRS-2023",
                    "gri_standard_version": None,
                    "gri_code": "E1-6", "gri_code_reported": "; ".join(codes[:6]) or None,
                    "disclosure_status_claimed": "reported", "disclosure_verified": True,
                    "claim_type": "quantitative",
                    "claim_text": label,
                    "value": float(de_num(tok)), "value_raw_text": tok,
                    "unit_reported": "t CO2e", "unit_canonical": "tCO2e",
                    "unit_conversion_factor": 1.0,
                    "is_intensity_metric": False, "denominator_basis": None,
                    "scope": scope,
                    "scope3_categories": None,
                    "boundary": "operational_control",
                    "boundary_changed_vs_prior": None,
                    "baseline_year": baseline_year,
                    "baseline_year_changed_vs_prior": None,
                    "is_baseline_column": (baseline_year is not None and int(yr) == baseline_year),
                    "period_end": f"{yr}-12-31",
                    "is_company_specific": COMPANY_SPECIFIC in label,
                    "is_subtotal": is_total,
                    "offsets_included": False,
                    "assurance_level": None, "assurance_covers_this_claim": None,
                    "is_restated": None,
                    "source_ref": {
                        "page_no": pno, "bbox": None, "verbatim_span": tok,
                        "table_id": f"E1-6-p{pno}", "row_idx": ln, "col_idx": ci,
                        "col_header_path": ["E1-6 THG-Bruttoemissionen", yr],
                        "extraction_path": "native_text",
                    },
                    "groundedness_verified": tok in page,
                    "confidence": 0.97, "decimal_separator": ",",
                    "extractor_version": "esg-extract@0.1.0", "model_id": "none-rule-based",
                    "prompt_hash": "-", "schema_version": "1.0",
                })
    return out

TARGET_YEAR = re.compile(r"^\s*(20[2-9]\d)\s*$")
REDUCTION = re.compile(r"um\s*≥?\s*(\d+)\s*%")

# Cắt theo TIÊU ĐỀ có dấu hai chấm ("Absolutes Ziel: Scope 1 und 2"), không cắt
# theo chuỗi trần "Absolutes Ziel" — chuỗi trần còn là NHÃN DÒNG bên trong bảng
# thuộc tính mục tiêu, cắt ở đó sẽ tách tiêu đề khỏi Basisjahr nằm dưới nó và
# làm rơi toàn bộ mục tiêu.
BLOCK_SPLIT = re.compile(r"(?=(?:Absolutes|Relatives)\s+Ziel\s*:)")

def extract_targets(pages, company_id, doc_hash, run_id):
    """Khối mục tiêu E1-4.

    Một TRANG có thể chứa NHIỀU khối mục tiêu với scope và baseline khác nhau:
    trang 64 của OMV có cả "Absolutes Ziel: Scope 1 und 2" (Bezugswert 13,9 Mio t)
    lẫn mục tiêu Scope 3 (113,7 Mio t). Quét cả trang một lượt sẽ lấy giá trị
    cuối cùng và gán baseline Scope 3 cho mục tiêu Scope 1+2 — sai 8 lần.
    Nên phải CẮT trang thành từng khối trước khi đọc.
    """
    out = []
    for pno, page in enumerate(pages, 1):
        if "Absolutes Ziel" not in page or "Basisjahr" not in page:
            continue
        codes = ESRS_CODE.findall(page[:1500])
        for blk in BLOCK_SPLIT.split(page):
            if "Basisjahr" not in blk:
                continue
            lines = blk.split("\n")
            heading = " ".join(l.strip() for l in lines[:3])
            if re.search(r"Scope\s*[-\u2011]?3", heading):
                tscope, covers3 = "scope_3", True
            elif re.search(r"Scope\s*[-\u2011]?1", heading):
                tscope, covers3 = "combined_1_2_market", False
            else:
                continue
            baseline_year = baseline_val = None
            for l in lines:
                if l.strip().startswith("Basisjahr"):
                    m = re.search(r"(\d{4})", l)
                    if m: baseline_year = int(m.group(1))
                if "Bezugswert in Mio t CO2e" in l:
                    m = re.search(r"(\d+[,.]\d+)\s*$", l.strip())
                    if m: baseline_val = float(m.group(1).replace(",", "."))
            offsets = not bool(re.search(r"(Zertifikate|Kompensation)[^.]{0,120}ausgeschlossen", blk))
            pend = []
            for j, l in enumerate(lines):
                m = TARGET_YEAR.match(l)
                if not m:
                    continue
                desc = next((x.strip() for x in lines[j + 1:j + 3] if x.strip()), "")
                if "Reduktion" not in desc and "Netto-Null" not in desc:
                    continue
                red = REDUCTION.search(desc)
                pend.append((int(m.group(1)), desc, red.group(1) if red else None, j))
            for ty, desc, red, ln in pend:
                out.append({
                    "claim_id": hashlib.sha256(f"{doc_hash}{pno}{tscope}{ln}t".encode()).hexdigest()[:32],
                    "run_id": run_id, "doc_hash": doc_hash, "company_id": company_id,
                    "report_year": 2025,
                    "framework": "ESRS", "framework_version": "ESRS-2023",
                    "gri_standard_version": None,
                    "gri_code": "E1-4", "gri_code_reported": "; ".join(codes[:6]) or None,
                    "claim_type": "target", "claim_text": desc[:300],
                    "disclosure_status_claimed": "reported", "disclosure_verified": True,
                    "value": float(red) if red else None,
                    "value_raw_text": red or desc[:40],
                    "unit_reported": "%" if red else None,
                    "unit_canonical": "pct" if red else None,
                    "unit_conversion_factor": 1.0,
                    "is_intensity_metric": False, "denominator_basis": None,
                    "scope": tscope, "scope3_categories": None,
                    "target_year": ty,
                    "target_type": "net_zero" if "Netto-Null" in desc else "absolute",
                    "interim_target_present": len(pend) > 1,
                    "target_covers_scope3": covers3,
                    "boundary": "operational_control",
                    "baseline_year": baseline_year,
                    "baseline_value_mt": baseline_val,
                    "offsets_included": offsets,
                    "assurance_level": None, "assurance_covers_this_claim": None,
                    "is_restated": None,
                    "source_ref": {
                        "page_no": pno, "bbox": None, "verbatim_span": desc[:80],
                        "table_id": f"E1-4-p{pno}-{tscope}", "row_idx": ln, "col_idx": 0,
                        "col_header_path": [heading[:60], str(ty)],
                        "extraction_path": "native_text",
                    },
                    "groundedness_verified": desc[:80] in page,
                    "confidence": 0.9, "decimal_separator": ",",
                    "extractor_version": "esg-extract@0.2.0", "model_id": "none-rule-based",
                    "prompt_hash": "-", "schema_version": "1.0",
                })
    return out


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--txt", required=True)
    ap.add_argument("--company-id", required=True)
    ap.add_argument("--out", required=True)
    a = ap.parse_args()
    txt = pathlib.Path(a.txt)
    pages = txt.read_text(encoding="utf-8", errors="replace").split("\f")
    dh = hashlib.sha256(txt.read_bytes()).hexdigest()
    rid = "esg-extract-2026-09-15"
    em = extract_emissions(pages, a.company_id, dh, rid)
    skipped = [r for r in em if "_skipped" in r]
    em = [r for r in em if "_skipped" not in r]
    tg = extract_targets(pages, a.company_id, dh, rid)
    seen, uniq = set(), []
    for r in tg:
        k = (r["scope"], r["target_year"], r["target_type"], r["value"])
        if k in seen:
            continue
        seen.add(k); uniq.append(r)
    tg = uniq
    rows = em + tg
    pathlib.Path(a.out).write_text(
        "\n".join(json.dumps(r, ensure_ascii=False) for r in rows) + "\n", encoding="utf-8")
    print(f"    [esg-extract] {len(em)} claim định lượng, {len(tg)} claim mục tiêu, "
          f"{len(skipped)} dòng bỏ do lệch số cột", file=sys.stderr)
    print(f"{len(rows)} claim -> {a.out}")
